FOUNDRY_URL=http://localhost:30000

# ── End-to-end test (pnpm e2e) ───────────────────────────────────────────────
# Foundry setup/admin password — needed to create and launch the test world.
FOUNDRY_ADMIN_KEY=
# World the test creates and uses. It never touches any other world.
E2E_WORLD_ID=beavers-voice-transcript-e2e
# Game system for the test world — blank = first installed system.
E2E_SYSTEM_ID=
# Leave the test world running after the test instead of returning to setup.
E2E_KEEP_WORLD_RUNNING=false
# Show the browser windows instead of running headless.
E2E_HEADFUL=false
# Path to Chrome — blank = look in the usual install locations.
CHROME_PATH=

# ── Manual client (pnpm list / read / write) ─────────────────────────────────
# Get these from the module settings: Settings → Beavers Voice Transcript → Connection Info
FOUNDRY_USER=
FOUNDRY_PASS=

# Optional: paste your browser session cookie here to skip login entirely.
# Get it from the browser console: document.cookie
FOUNDRY_COOKIE=

# Set to true to log all incoming socket events for debugging.
DEBUG=false
